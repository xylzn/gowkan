---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { supabasePublic } from '../../lib/supabase';
import type { Article } from '../../lib/types';

const { data: rows } = await supabasePublic
    .from('articles')
    .select('*')
    .order('pub_date', { ascending: false });

const articles: Article[] = (rows ?? []) as Article[];

const categories: Record<string, { color: string, border: string }> = {
    "Tips & Trick": { color: "text-[#6366f1]", border: "hover:border-[#6366f1]/50" },
    "Branding": { color: "text-[#a855f7]", border: "hover:border-[#a855f7]/50" },
    "Optimization": { color: "text-[#ec4899]", border: "hover:border-[#ec4899]/50" }
};
---

<MainLayout
    title="Blog Gowkan - Wawasan Digital & Branding Terupdate"
    description="Temukan tips, trik, dan berita terbaru seputar teknologi web dan strategi branding untuk bisnis Anda."
    imageAlt="Blog GOWKAN - Edukasi Digital & Branding"
    keywords={['blog website', 'tips digital', 'branding indonesia', 'artikel web development', 'gowkan blog', 'seo website']}
>
    <Navbar />
    <main class="pt-32 pb-24 px-6 min-h-screen">
        <div class="container mx-auto max-w-6xl reveal">
            <div class="text-center mb-16">
                <div class="inline-block px-4 py-1.5 mb-6 rounded-full border border-[#6366f1]/30 bg-[#6366f1]/10 text-[#6366f1] text-[10px] font-bold uppercase tracking-widest">
                    Blog Gowkan
                </div>
                <h1 class="text-4xl md:text-6xl font-black mb-8 leading-tight text-white tracking-tight">
                    Edukasi <span class="text-[#6366f1]">Digital</span> & Branding
                </h1>
                <p class="text-white/40 text-lg max-w-2xl mx-auto leading-relaxed font-medium">
                    Temukan artikel pilihan kami untuk membantu Anda memahami dunia digital dan memaksimalkan potensi bisnis Anda.
                </p>
            </div>

            {articles.length === 0 ? (
                <div class="glass-card rounded-[3rem] p-16 text-center border border-white/10">
                    <div class="w-24 h-24 mx-auto bg-[#6366f1]/10 rounded-[2.5rem] flex items-center justify-center text-[#6366f1] mb-8">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                    </div>
                    <h3 class="text-2xl md:text-3xl font-black mb-4">Belum Ada Artikel</h3>
                    <p class="text-white/40 font-medium mb-10 max-w-md mx-auto text-lg">
                        Artikel edukasi digital & branding sedang kami siapkan. Silakan kembali lagi nanti.
                    </p>
                </div>
            ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {articles.map((art) => {
                        const categoryStyle = categories[art.category || ""] || { color: "text-white", border: "hover:border-white/50" };
                        const pubDate = art.pub_date ? new Date(art.pub_date) : null;
                        return (
                            <div class="glass-card package-card p-8 rounded-[3rem] border border-white/10 hover:border-[#6366f1]/50 transition-all group h-full flex flex-col">
                                <div class="aspect-video bg-white/5 rounded-3xl mb-8 overflow-hidden">
                                    <img
                                        src={art.hero_image_url}
                                        alt={art.title}
                                        loading="lazy"
                                        referrerpolicy="no-referrer"
                                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                                        onerror="this.style.display='none'; this.parentElement.innerHTML += '<div class=\'w-full h-full flex items-center justify-center text-white/30 bg-white/5 text-sm font-bold\'>Hero Image</div>';"
                                    />
                                </div>
                                <div class="flex-grow px-2">
                                    <div class="flex items-center gap-4 mb-6 flex-wrap">
                                        <span class={`inline-block px-4 py-1.5 rounded-full bg-white/5 ${categoryStyle.color} text-[10px] font-bold uppercase tracking-[0.2em]`}>{art.category}</span>
                                        {pubDate && (
                                            <span class="text-white/30 text-[10px] font-bold uppercase tracking-widest">
                                                {pubDate.toLocaleDateString('id-ID', { year:'numeric', month:'short', day:'numeric' })}
                                            </span>
                                        )}
                                    </div>
                                    <h3 class="text-2xl font-black mb-6 leading-tight group-hover:text-[#6366f1] transition-colors tracking-tight">{art.title}</h3>
                                    <p class="text-white/40 text-sm leading-relaxed mb-6 font-medium line-clamp-3">{art.description}</p>
                                </div>
                                <a href={`/blog/${art.slug}`} class="text-sm font-black flex items-center gap-3 text-white/30 group-hover:text-[#6366f1] transition-all mt-auto px-2">
                                    BACA SELENGKAPNYA
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                    </svg>
                                </a>
                            </div>
                        );
                    })}
                </div>
            )}
        </div>
    </main>
    <Footer />
</MainLayout>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const rv = new IntersectionObserver((es) => es.forEach(e => {
            if (e.isIntersecting) { e.target.classList.add('active'); rv.unobserve(e.target); }
        }), { threshold: 0.05 });
        document.querySelectorAll('.reveal').forEach(el => rv.observe(el));
    });
</script>
