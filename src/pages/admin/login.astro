---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout
    title="Admin Login | GOWKAN"
    description="Panel admin GOWKAN"
>
    <main class="min-h-screen flex items-center justify-center px-6 py-24">
        <!-- Background Decoration -->
        <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
            <div class="absolute -top-[10%] -left-[10%] w-[50%] h-[50%] bg-[#6366f1]/20 blur-[120px] rounded-full animate-blob"></div>
            <div class="absolute top-[20%] -right-[10%] w-[45%] h-[45%] bg-[#a855f7]/20 blur-[120px] rounded-full animate-blob animation-delay-2000"></div>
            <div class="absolute -bottom-[10%] left-[20%] w-[40%] h-[40%] bg-[#ec4899]/20 blur-[120px] rounded-full animate-blob"></div>
        </div>

        <div class="w-full max-w-md reveal">
            <div class="text-center mb-12">
                <div class="text-5xl font-extrabold tracking-tighter text-white mb-4">
                    GOW<span class="text-[#6366f1]">KAN</span>
                </div>
                <div class="inline-block px-4 py-1.5 mb-6 rounded-full border border-[#6366f1]/30 bg-[#6366f1]/10 text-[#6366f1] text-[10px] font-bold uppercase tracking-widest">
                    Admin Panel
                </div>
                <h1 class="text-3xl md:text-4xl font-black mb-4 tracking-tight">Masuk ke Dashboard</h1>
                <p class="text-white/40 font-medium">Gunakan kredensial admin Anda untuk mengelola konten website.</p>
            </div>

            <div class="glass-card rounded-[3rem] p-10 border border-white/10 shadow-2xl">
                <form id="login-form" class="space-y-6">
                    <div>
                        <label for="email" class="block text-sm font-bold text-white/60 uppercase tracking-widest mb-3">Email</label>
                        <input
                            id="email"
                            name="email"
                            type="email"
                            required
                            autocomplete="email"
                            placeholder="admin@gowkan.com"
                            class="glass-input w-full"
                        />
                    </div>

                    <div>
                        <label for="password" class="block text-sm font-bold text-white/60 uppercase tracking-widest mb-3">Password</label>
                        <input
                            id="password"
                            name="password"
                            type="password"
                            required
                            autocomplete="current-password"
                            placeholder="••••••••"
                            class="glass-input w-full"
                        />
                    </div>

                    <div id="error-box" class="hidden rounded-3xl bg-red-500/10 border border-red-500/30 px-6 py-4 text-red-300 text-sm font-medium"></div>

                    <button
                        type="submit"
                        id="submit-btn"
                        class="w-full py-5 bg-[#6366f1] text-white rounded-[2rem] font-black text-lg shadow-xl shadow-[#6366f1]/20 hover:shadow-[#6366f1]/40 hover:-translate-y-1 transition-all duration-500 cta-highlight cta-glow disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none"
                    >
                        <span id="btn-text">Login</span>
                        <span id="btn-loading" class="hidden">Memproses...</span>
                    </button>
                </form>
            </div>

            <div class="mt-10 text-center text-white/20 text-sm font-medium">
                © 2026 GOWKAN. Panel Admin Terproteksi.
            </div>
        </div>
    </main>
</MainLayout>

<script>
    const form = document.getElementById('login-form') as HTMLFormElement | null;
    const errorBox = document.getElementById('error-box');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const btnLoading = document.getElementById('btn-loading');

    function showError(msg: string) {
        if (!errorBox) return;
        errorBox.textContent = msg;
        errorBox.classList.remove('hidden');
    }

    function hideError() {
        errorBox?.classList.add('hidden');
    }

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError();
        if (!submitBtn || !btnText || !btnLoading) return;
        submitBtn.disabled = true;
        btnText.classList.add('hidden');
        btnLoading.classList.remove('hidden');

        try {
            const fd = new FormData(form);
            const email = String(fd.get('email') || '').trim();
            const password = String(fd.get('password') || '');

            const res = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password }),
            });

            const data = await res.json().catch(() => ({}));
            if (data?.success && data?.redirect) {
                window.location.href = data.redirect;
            } else {
                showError(data?.error || 'Login gagal. Silakan coba lagi.');
            }
        } catch (err: any) {
            showError(err?.message || 'Koneksi error. Periksa jaringan Anda.');
        } finally {
            if (submitBtn && btnText && btnLoading) {
                submitBtn.disabled = false;
                btnText.classList.remove('hidden');
                btnLoading.classList.add('hidden');
            }
        }
    });
</script>
