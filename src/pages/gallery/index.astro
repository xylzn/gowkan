---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PreviewModal from '../../components/PreviewModal.astro';
import Button from '../../components/Button.astro';
import { supabasePublic } from '../../lib/supabase';
import type { GalleryItem } from '../../lib/types';

const { data: rows } = await supabasePublic
    .from('gallery_items')
    .select('*')
    .order('urutan_tampil', { ascending: true })
    .order('created_at', { ascending: false });

const items: GalleryItem[] = (rows ?? []) as GalleryItem[];
---

<MainLayout
    title="Portfolio Gallery | GOWKAN - Karya Website Nyata"
    description="Koleksi proyek website nyata yang telah dikerjakan GOWKAN untuk klien di berbagai sektor industri."
>
    <Navbar />
    <PreviewModal />
    <main class="pt-32 pb-24 px-6 min-h-screen">
        <div class="container mx-auto max-w-7xl">
            <!-- Header -->
            <div class="text-center mb-20 reveal">
                <div class="inline-block px-4 py-1.5 mb-6 rounded-full border border-[#a855f7]/30 bg-[#a855f7]/10 text-[#a855f7] text-[10px] font-bold uppercase tracking-widest">
                    Portfolio Kami
                </div>
                <h1 class="text-4xl md:text-6xl lg:text-7xl font-black mb-8 leading-tight text-white tracking-tight">
                    Karya <span class="text-[#a855f7]">Terbaik</span> Kami
                </h1>
                <p class="text-white/40 text-lg max-w-2xl mx-auto leading-relaxed font-medium">
                    Koleksi proyek website nyata yang telah kami kerjakan untuk klien.
                    Klik "Lihat Demo" untuk melihat detail pekerjaan dan mengunjungi website aslinya.
                </p>
            </div>

            {items.length === 0 ? (
                <div class="glass-card rounded-[3rem] p-16 md:p-24 text-center border border-white/10 reveal">
                    <div class="w-24 h-24 mx-auto bg-[#a855f7]/10 rounded-[2.5rem] flex items-center justify-center text-[#a855f7] mb-8">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-7h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                    </div>
                    <h3 class="text-2xl md:text-3xl font-black mb-4">Belum Ada Proyek</h3>
                    <p class="text-white/40 font-medium mb-10 max-w-md mx-auto text-lg">
                        Portfolio proyek sedang kami siapkan. Silakan kembali lagi nanti untuk melihat karya-karya terbaru GOWKAN.
                    </p>
                    <Button href="/#contact" variant="primary">Konsultasi Proyek</Button>
                </div>
            ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 reveal">
                    {items.map((item, i) => (
                        <div class="carousel-item" style={`transition-delay: ${i * 50}ms;`}>
                            <div class="glass-card package-card gallery-item p-6 rounded-[3rem] border border-white/10 transition-all group h-full flex flex-col">
                                <div class="aspect-video overflow-hidden rounded-3xl mb-8 relative">
                                    <img
                                        src={item.thumbnail_url}
                                        alt={item.nama_proyek}
                                        loading="lazy"
                                        referrerpolicy="no-referrer"
                                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                                        onerror="this.style.display='none'; this.parentElement.innerHTML += '<div class=\'absolute inset-0 flex items-center justify-center text-white/30 bg-white/5 text-sm font-bold\'>Image</div>';"
                                    />
                                    <div class="absolute inset-0 bg-[#6366f1]/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-[2px]">
                                        <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-[#6366f1] shadow-xl scale-50 group-hover:scale-100 transition-transform duration-500">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                        </div>
                                    </div>
                                </div>
                                <div class="px-2 flex-grow">
                                    <div class="flex items-center gap-2 mb-4">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#a855f7]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-7h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                                        <span class="text-[#a855f7] text-[10px] font-bold uppercase tracking-[0.2em] block">{item.kategori}</span>
                                    </div>
                                    <h3 class="text-2xl font-black mb-6 tracking-tight group-hover:text-[#a855f7] transition-colors">{item.nama_proyek}</h3>
                                    <p class="text-white/40 text-sm leading-relaxed font-medium mb-6 line-clamp-3">{item.ringkasan}</p>
                                </div>
                                <button
                                    class="px-8 py-3 bg-[#6366f1] text-white rounded-2xl text-sm font-black w-full text-center hover:bg-[#a855f7] transition-all cta-highlight cta-glow mt-auto"
                                    data-gallery-id={item.id}
                                    data-nama={item.nama_proyek}
                                    data-kategori={item.kategori}
                                    data-thumbnail={item.thumbnail_url}
                                    data-ringkasan={item.ringkasan}
                                    data-detail={item.detail_pekerjaan}
                                    data-url={item.url}
                                >
                                    Lihat Demo
                                </button>
                            </div>
                        </div>
                    ))}
                </div>
            )}
        </div>
    </main>
    <Footer />
</MainLayout>

<script is:inline>
    // Inline script: inject all gallery items data (from SSR-rendered data attributes already on buttons)
    // The PreviewModal script listens to [data-gallery-id] clicks.
    // Add reveal observer and active class to carousel items in grid view for better UX
    document.addEventListener('DOMContentLoaded', () => {
        const gridItems = document.querySelectorAll('.grid > .carousel-item');
        gridItems.forEach((el, i) => {
            setTimeout(() => {
                el.classList.add('is-visible', 'active');
                el.style.opacity = '1';
                el.style.transform = 'scale(1) translateZ(0)';
            }, 150 + i * 80);
        });
        const rv = new IntersectionObserver((es) => es.forEach(e => {
            if (e.isIntersecting) { e.target.classList.add('active'); rv.unobserve(e.target); }
        }), { threshold: 0.05 });
        document.querySelectorAll('.reveal').forEach(el => rv.observe(el));
    });
</script>
