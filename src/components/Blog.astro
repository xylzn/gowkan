---
import { supabasePublic } from '../lib/supabase';
import type { Article } from '../lib/types';

const { data: rows } = await supabasePublic
    .from('articles')
    .select('*')
    .order('pub_date', { ascending: false })
    .limit(3);

const posts: Article[] = (rows ?? []) as Article[];

const categories: Record<string, { color: string, border: string }> = {
    "Tips & Trick": { color: "text-[#6366f1]", border: "hover:border-[#6366f1]/50" },
    "Branding": { color: "text-[#a855f7]", border: "hover:border-[#a855f7]/50" },
    "Optimization": { color: "text-[#ec4899]", border: "hover:border-[#ec4899]/50" }
};
---

<!-- Blog Section -->
<section id="blog" class="py-24 px-6 relative overflow-hidden">
    <div class="container mx-auto max-w-7xl">
        <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8 reveal">
            <div class="max-w-2xl">
                <div class="inline-block px-4 py-1.5 mb-6 rounded-full border border-[#6366f1]/30 bg-[#6366f1]/10 text-[#6366f1] text-[10px] font-bold uppercase tracking-widest">
                    Wawasan Terbaru
                </div>
                <h2 class="text-4xl md:text-5xl font-black mb-6 tracking-tight">Edukasi <span class="text-[#6366f1]">Digital</span></h2>
                <p class="text-white/40 font-medium">Tips, trik, dan berita terbaru seputar teknologi web dan strategi branding. <span class="text-[#6366f1]/60 text-xs block mt-2 md:inline md:mt-0 md:ml-2">(Geser untuk melihat lainnya →)</span></p>
            </div>
            <div class="flex items-center gap-4">
                <a href="/blog" class="hidden sm:inline-flex items-center gap-3 px-6 py-3.5 glass-card text-[#6366f1] border border-[#6366f1]/30 rounded-full text-xs font-bold uppercase tracking-widest hover:bg-[#6366f1]/10 transition-all">
                    Lihat Semua Artikel
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </a>
                <div class="hidden md:flex gap-4">
                    <button id="blog-prev" class="arrow-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                    </button>
                    <button id="blog-next" class="arrow-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                    </button>
                </div>
            </div>
        </div>

        <a href="/blog" class="sm:hidden inline-flex w-full sm:w-auto items-center justify-center gap-3 px-6 py-4 glass-card text-[#6366f1] border border-[#6366f1]/30 rounded-full text-sm font-bold uppercase tracking-widest hover:bg-[#6366f1]/10 transition-all mb-12">
            Lihat Semua Artikel
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
        </a>

        <div class="carousel-wrapper">
            <div id="blog-carousel" class="carousel-container reveal">
                <div class="carousel-track">
                    {posts.map((art) => {
                        const categoryStyle = categories[art.category || ""] || { color: "text-white", border: "hover:border-white/50" };
                        const pubDate = art.pub_date ? new Date(art.pub_date) : null;
                        return (
                            <div class="carousel-item">
                                <div class={`glass-card package-card p-8 rounded-[3rem] border border-white/10 ${categoryStyle.border} transition-all group h-full flex flex-col`}>
                                    <div class="aspect-video bg-white/5 rounded-3xl mb-8 overflow-hidden">
                                        <img
                                            src={art.hero_image_url}
                                            alt={art.title}
                                            loading="lazy"
                                            referrerpolicy="no-referrer"
                                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                                            onerror="this.style.display='none'; this.parentElement.innerHTML += '<div class=\'w-full h-full flex items-center justify-center text-white/30 bg-white/5 text-sm font-bold\'>Hero Image</div>';"
                                        />
                                    </div>
                                    <div class="flex-grow px-2">
                                        <div class="flex items-center gap-4 mb-6 flex-wrap">
                                            <span class={`inline-block px-4 py-1.5 rounded-full bg-white/5 ${categoryStyle.color} text-[10px] font-bold uppercase tracking-[0.2em]`}>{art.category}</span>
                                            {pubDate && (
                                                <span class="text-white/30 text-[10px] font-bold uppercase tracking-widest">
                                                    {pubDate.toLocaleDateString('id-ID', { year:'numeric', month:'short', day:'numeric' })}
                                                </span>
                                            )}
                                        </div>
                                        <h3 class="text-2xl font-black mb-6 leading-tight group-hover:text-[#6366f1] transition-colors tracking-tight">{art.title}</h3>
                                        <p class="text-white/40 text-sm leading-relaxed mb-6 font-medium line-clamp-3">{art.description}</p>
                                    </div>
                                    <a href={`/blog/${art.slug}`} class="text-sm font-black flex items-center gap-3 text-white/30 group-hover:text-[#6366f1] transition-all mt-auto px-2">
                                        BACA SELENGKAPNYA
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>
        </div>
    </div>
</section>
