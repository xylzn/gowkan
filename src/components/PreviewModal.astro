---
---

<!-- Preview Modal -->
<div id="preview-modal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 md:p-6 opacity-0 pointer-events-none transition-all duration-500">
    <div class="absolute inset-0 bg-[#0f172a]/90 backdrop-blur-xl" id="modal-bg"></div>
    <div class="glass-card max-w-4xl w-full max-h-[90vh] flex flex-col rounded-[3rem] relative z-10 scale-90 transition-all duration-500 border border-white/10 shadow-2xl overflow-hidden">
        <!-- Header (Fixed) -->
        <div class="p-8 pb-4 flex justify-between items-start relative z-20">
            <div>
                <span id="modal-category" class="text-[#6366f1] text-[10px] font-black uppercase tracking-[0.2em] mb-2 block">Category</span>
                <h3 id="modal-title" class="text-3xl md:text-4xl font-black text-white tracking-tight">Project Title</h3>
            </div>
            <button id="close-modal" class="w-12 h-12 glass-card rounded-full flex items-center justify-center hover:bg-[#6366f1] hover:text-white transition-all border border-white/10 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Content (Scrollable Area) -->
        <div class="flex-grow overflow-y-auto custom-scrollbar p-8 pt-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                <!-- Image -->
                <div class="aspect-video md:aspect-[4/5] rounded-[2.5rem] overflow-hidden bg-white/5 border border-white/5">
                    <img id="modal-image" src="" alt="" class="w-full h-full object-cover">
                </div>

                <!-- Details -->
                <div class="flex flex-col">
                    <div class="mb-8">
                        <h4 class="text-xs font-black text-white/30 uppercase tracking-[0.2em] mb-4">Ringkasan Proyek</h4>
                        <p id="modal-ringkasan" class="text-xl md:text-2xl font-bold text-white leading-tight italic">"Ringkasan proyek muncul di sini."</p>
                    </div>

                    <div class="flex flex-col flex-grow min-h-0">
                        <h4 class="text-xs font-black text-white/30 uppercase tracking-[0.2em] mb-4">Detail Pekerjaan</h4>
                        <div class="flex-grow overflow-y-auto custom-scrollbar pr-4 max-h-[400px]">
                            <p id="modal-detail" class="text-white/60 font-medium leading-relaxed whitespace-pre-wrap">Detail tentang apa yang dikerjakan untuk proyek ini.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer (Fixed) -->
        <div class="p-8 pt-4 border-t border-white/5 bg-white/[0.02] backdrop-blur-md relative z-20">
            <div class="flex flex-col sm:flex-row gap-4">
                <a id="modal-visit-url" target="_blank" rel="noopener noreferrer" href="#" class="flex-1 text-center py-5 glass-card text-[#6366f1] border border-[#6366f1]/30 rounded-[2rem] font-black text-lg hover:bg-[#6366f1]/10 transition-all duration-300 cta-highlight">
                    🔗 Kunjungi Website
                </a>
                <a href="#contact-form-section" id="modal-cta" class="flex-1 text-center py-5 bg-[#6366f1] text-white rounded-[2rem] font-black text-lg shadow-xl shadow-[#6366f1]/20 hover:shadow-[#6366f1]/40 hover:-translate-y-1 transition-all duration-500 cta-highlight cta-glow">
                    💬 Konsultasi Project Ini
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    const modal = document.getElementById('preview-modal');
    const modalImage = document.getElementById('modal-image') as HTMLImageElement;
    const modalCategory = document.getElementById('modal-category');
    const modalTitle = document.getElementById('modal-title');
    const modalRingkasan = document.getElementById('modal-ringkasan');
    const modalDetail = document.getElementById('modal-detail');
    const modalVisitUrl = document.getElementById('modal-visit-url') as HTMLAnchorElement;
    const closeModal = document.getElementById('close-modal');
    const modalBg = document.getElementById('modal-bg');
    const modalCta = document.getElementById('modal-cta');

    const hideModal = () => {
        modal?.classList.add('opacity-0', 'pointer-events-none');
        modal?.querySelector('.glass-card')?.classList.add('scale-90');
        document.body.style.overflow = '';
    };

    closeModal?.addEventListener('click', hideModal);
    modalBg?.addEventListener('click', hideModal);
    modalCta?.addEventListener('click', hideModal);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hideModal(); });

    function showModal(data: {
        nama_proyek: string;
        kategori: string;
        thumbnail_url: string;
        ringkasan: string;
        detail_pekerjaan: string;
        url: string;
    }) {
        if (!modal || !modalImage || !modalCategory || !modalTitle || !modalRingkasan || !modalDetail || !modalVisitUrl) return;
        modalImage.src = data.thumbnail_url || '';
        modalImage.alt = data.nama_proyek || '';
        modalCategory.textContent = data.kategori || '';
        modalTitle.textContent = data.nama_proyek || '';
        modalRingkasan.textContent = data.ringkasan ? `"${data.ringkasan}"` : '';
        modalDetail.textContent = data.detail_pekerjaan || '';
        modalVisitUrl.href = data.url || '#';
        // Hide visit button if no URL
        if (!data.url || data.url.trim() === '' || data.url.trim() === 'https://') {
            modalVisitUrl.style.display = 'none';
        } else {
            modalVisitUrl.style.display = '';
        }
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.querySelector('.glass-card')?.classList.remove('scale-90');
        document.body.style.overflow = 'hidden';
    }

    // Listen to NEW trigger pattern: data-gallery-id buttons
    document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement)?.closest('[data-gallery-id]') as HTMLElement | null;
        if (!target) return;
        e.preventDefault();
        const data = {
            nama_proyek: target.getAttribute('data-nama') || '',
            kategori: target.getAttribute('data-kategori') || '',
            thumbnail_url: target.getAttribute('data-thumbnail') || '',
            ringkasan: target.getAttribute('data-ringkasan') || '',
            detail_pekerjaan: target.getAttribute('data-detail') || '',
            url: target.getAttribute('data-url') || '',
        };
        showModal(data);
    });
</script>
